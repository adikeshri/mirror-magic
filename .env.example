# Server settings for `npm start`. Copy to .env to use.

# Port to listen on.
PORT=8080

# Interface to bind. 127.0.0.1 keeps the mirror private to this machine;
# use 0.0.0.0 to open it on your LAN.
HOST=127.0.0.1

# Path to the mirror's config file.
MIRROR_CONFIG=config.json

# Where the market quote cache is stored.
MIRROR_CACHE_DIR=.cache

# Server settings for `npm start`. Copy to .env to use.

# Port to listen on.
PORT=8080

# Interface to bind. 127.0.0.1 keeps the mirror private to this machine;
# use 0.0.0.0 to open it on your LAN.
HOST=127.0.0.1

# Where Mira (the backend) is running. All data comes from it.
MIRA_URL=http://127.0.0.1:5080
